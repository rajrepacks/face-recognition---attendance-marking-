# Async SQLAlchemy URL - the driver must be asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/face_attendance

# Comma separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Cosine similarity required to accept a match (higher = stricter).
FACE_MATCH_THRESHOLD=0.65
# MTCNN confidence required to accept a detected face.
FACE_MIN_DETECTION_PROB=0.90
# Boxes below this confidence are ignored entirely (not counted as faces).
FACE_DETECTION_FLOOR=0.60
